# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PowerShell files are CRLF in the working tree (see .gitattributes) because
# Windows PowerShell 5.1 tooling expects it.
[*.{ps1,psm1,psd1}]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
