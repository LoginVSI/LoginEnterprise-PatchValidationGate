{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supported functional gate policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyVersion",
    "name",
    "test",
    "execution",
    "functional",
    "performance",
    "promotion",
    "inconclusiveWhen"
  ],
  "properties": {
    "policyVersion": {
      "const": "1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxWaitMinutes",
        "pollIntervalSeconds"
      ],
      "properties": {
        "maxWaitMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "pollIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "functional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredApplications",
        "allowStepRetries",
        "failOnAnyApplicationFailure"
      ],
      "properties": {
        "requiredApplications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "REPLACE|CONFIGURE|<"
            }
          }
        },
        "allowStepRetries": {
          "const": 0
        },
        "failOnAnyApplicationFailure": {
          "const": true
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "const": false
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMode",
        "autoRequires"
      ],
      "properties": {
        "defaultMode": {
          "enum": [
            "manual",
            "auto"
          ]
        },
        "autoRequires": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "verdict:PASS",
              "results-complete"
            ]
          }
        }
      }
    },
    "inconclusiveWhen": {
      "const": [
        "test-not-found",
        "preflight-failed",
        "run-timeout",
        "launcher-or-connection-error",
        "results-incomplete",
        "policy-invalid"
      ]
    }
  }
}
