{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patch validation policy",
  "type": "object",
  "required": ["policyVersion", "name", "test", "execution", "functional"],
  "properties": {
    "policyVersion": { "type": "string" },
    "name": { "type": "string" },
    "test": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" } }
    },
    "execution": {
      "type": "object",
      "properties": {
        "maxWaitMinutes": { "type": "integer", "minimum": 1 },
        "pollIntervalSeconds": { "type": "integer", "minimum": 5 }
      }
    },
    "functional": {
      "type": "object",
      "properties": {
        "requiredApplications": { "type": "array", "items": { "type": "string" } },
        "allowStepRetries": { "type": "integer", "minimum": 0 },
        "failOnAnyApplicationFailure": { "type": "boolean" }
      }
    },
    "performance": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "promotion": {
      "type": "object",
      "properties": {
        "defaultMode": { "type": "string", "enum": ["manual", "auto"] },
        "autoRequires": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inconclusiveWhen": { "type": "array", "items": { "type": "string" } }
  }
}